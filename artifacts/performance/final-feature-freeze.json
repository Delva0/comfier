  "public_contract": {
    "files": [
      "roots(*, directory=None, category=None)",
      "upload(local_path, *, directory=None, root=None, path=None)",
      "download(remote_file, local_path, *, directory=None, root=None, overwrite=False)",
      "stat(remote_file, *, directory=None, root=None, checksum=False)",
      "remove(remote_file, *, directory=None, root=None, missing_ok=False)"
    ],
    "metadata": "RemoteFile.name=relative_path; native node inputs use native_name. stat checksum=False returns sha256=None; completed upload/download have SHA256.",
    "ownership": "Files proxy strongly owns Client; Client never caches proxy. Metadata owns no Client. Files I/O is external to graph capture.",
    "compression": "Client(url, fetch_compression='auto'|'identity'); same on HTTPTransport. With transport= configure that transport directly. Only object fetch is compressed."
  },
  "limits": [
    "HTTPTransport implements streaming; other transports need an optional stream interface or receive UnsupportedTransport. Existing compute paths unchanged.",
    "No default file-size quota; NativeRuntime(max_file_bytes=None) may set an explicit deployment limit. Chunk size 1 MiB; metadata frames capped at 64 KiB.",
    "No resume, directory sync, implicit Path upload, automatic final-file GC, overwrite upload, or automatic write retries.",
    "A completed atomic commit remains persistent after late cancellation or response loss; use explicit path when post-failure stat tracking is needed.",
    "Files are shared under existing daemon authorization. Configured symlink roots are canonicalized; descendant symlink/reparse paths are rejected. Revision checks are optimistic, not filesystem snapshots.",
    "Atomic create-only publication requires same-filesystem hard links; unsupported filesystems fail. Actual Linux/HTTP tests passed; Windows full runtime not yet accepted.",
    "Standard MIME epilogue is allowed after upload's three verified parts; epilogue is not file content. Single-pass download publishes locally only after its final digest/footer succeeds."
